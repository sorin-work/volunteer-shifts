{
  "name": "volunteer-shifts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Volunteer shift scheduling for food banks, festivals and other nonprofits.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
