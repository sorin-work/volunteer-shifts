# Copy to .env and adjust. docker compose reads WEB_PORT, MAILPIT_PORT and DB_PORT;
# the API reads the rest (npm run dev -w apps/api loads them from your shell).

WEB_PORT=4420
MAILPIT_PORT=8025
DB_PORT=5432

DATABASE_URL=postgres://volunteer:volunteer@localhost:5432/volunteer_shifts
APP_URL=http://localhost:5173
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Volunteer Shifts <no-reply@volunteer-shifts.local>"
ORG_NAME="Riverside Community Volunteers"
SEED_DEMO=true
LOG_LEVEL=debug
